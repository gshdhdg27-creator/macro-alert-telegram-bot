# Telegram
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_ID=your_telegram_user_id_here

# OpenAI (for AI filtering & summaries)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Optional paid/fast sources (leave empty to use free/fallback)
FMP_API_KEY=
BENZINGA_API_KEY=

# Timezone default (IANA)
DEFAULT_TIMEZONE=Europe/Moscow

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Logging
LOG_LEVEL=INFO
